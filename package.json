{
  "name": "onedrive-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Static, client-only OneDrive file browser and viewer.",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "dev:headful": "node tests/e2e/localdev.js --headful",
    "dev:headless": "node tests/e2e/localdev.js --headless"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2"
  }
}
